<!DOCTYPE html>
<html lang="en">
<head>
  {% include "partials/head.njk" %}
</head>
<body>
  <a href="#main-content">Skip to main content</a>
  {% include "partials/header.njk" %}
  <main id="main-content">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  {%- if scripts %}
  {%- for script in scripts %}
  <script src="{{ script | url }}" defer></script>
  {%- endfor %}
  {%- endif %}
</body>
</html>
