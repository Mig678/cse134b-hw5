---
layout: base.njk
---
<article>
  {%- if project.type %}
  <p><strong>Type:</strong> {{ project.type }}</p>
  {%- endif %}

  <p><strong>Dates:</strong> {{ project.dates }}</p>

  <section>
    <h2>Technologies</h2>
    <ul>
      {%- for tech in project.technologies %}
      <li>{{ tech }}</li>
      {%- endfor %}
    </ul>
  </section>

  <section>
    <h2>Details</h2>
    <ul>
      {%- for item in project.details %}
      <li>{{ item }}</li>
      {%- endfor %}
    </ul>
  </section>

  <p><a href="{{ '/projects/' | url }}">Back to Projects</a></p>
</article>
